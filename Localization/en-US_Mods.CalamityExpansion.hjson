Buffs: {
	DaybreakEX: {
		DisplayName: Daybreak EX
		Description: Rays of the blazing sun burn without restraint
	}

	HellfireIV: {
		DisplayName: Hellfire IV
		Description: Never extinguished; all things turn to ash
	}

	NeutronEntropy: {
		DisplayName: Neutron Entropy
		Description: The energy of neutron resonance shatters reality
	}
}

Items: {
	FireGauntletEX: {
		DisplayName: Fire Gauntlet EX
		Tooltip:
			'''
			+8 defense
			22% increased melee damage
			22% increased melee critical strike chance
			22% increased melee attack speed
			+400 aggro
			Melee knockback is doubled, melee weapon size +20%
			Allows autoswing for melee weapons and whips
			Melee hits inflict Hellfire IV
			'''
	}

	NeutronBar: {
		DisplayName: Neutron Bar
		Tooltip: The weight of all things, gathered at your fingertips
	}

	NeutronGlaive: {
		DisplayName: Neutron Blade
		Tooltip:
			'''
			Swinging releases powerful gravitational sword waves
			Waves causing a neutron star explosion upon hitting a target
			Right-click to charge the blade, releasing a large neutron star explosion when fully charged
			Releasing early causes the energy to spill out
			'''
	}

	NeutronGun: {
		DisplayName: Neutron Pulse
		Tooltip:
			'''
			Fires gravity projectiles that create neutron star warp points and rain gamma rays down upon impact
			Right-click to switch to heavy mode: it fires much more slowly, but each shot hits far harder
			Each shot charges the gun, and when fully charged, the next shot triggers a neutron star explosion at the cursor
			"Shoot the sun down!"
			'''
	}

	RangerEmblemEX: {
		DisplayName: Ranger Emblem EX
		Tooltip:
			'''
			18% increased ranged damage
			18% increased ranged critical strike chance
			18% increased arrow damage
			18% increased ammo velocity
			82% chance not to consume ammo
			'''
	}

	SniperScopeEX: {
		DisplayName: Sniper Scope EX
		Tooltip:
			'''
			22% increased ranged damage
			22% increased ranged critical strike chance
			22% increased ranged projectile velocity
			+50 ranged armor penetration
			40% chance not to consume ammo
			Grants the effects of the Magic Quiver
			50% chance to fire an extra Luminite Arrow or Luminite Bullet
			Grants the Recon Scope's zoom while visible
			'''
	}

	WarriorEmblemEX: {
		DisplayName: Warrior Emblem EX
		Tooltip:
			'''
			18% increased melee damage
			18% increased melee critical strike chance
			18% increased melee attack speed
			Melee hits inflict Daybreak EX (on enemies and players alike)
			'''
	}
}

Rarities: {
	NeutronRarity.DisplayName: Neutron
	WarriorEXRarity.DisplayName: Warrior EX
	RangerEXRarity.DisplayName: Ranger EX
}

Projectiles: {
	CENeutronExplode.DisplayName: Neutron Explosion
	CENeutronExplosionRanged.DisplayName: Neutron Explosion
	NeutronBullet.DisplayName: Neutron Bullet
	NeutronExplode.DisplayName: Neutron Explode
	NeutronExplosionRanged.DisplayName: Neutron Explosion
	NeutronGunHoldout.DisplayName: Neutron Pulse
	NeutronGlaiveBeam.DisplayName: Neutron Blade Beam
	NeutronGlaiveHeld.DisplayName: Neutron Blade
	NeutronLaser.DisplayName: Neutron Laser
	NeutronsOrb.DisplayName: Neutron Orb
}

Configs: {
	ConfigSystem: {
		DisplayName: Calamity Expansion Config

		PerformanceMode: {
			Label: Performance Mode
			Tooltip:
				'''
				Stops drawing afterimage trails for this mod's projectiles to reduce rendering load.
				Nothing in the current neutron chain (Neutron Blade and its projectiles) uses afterimage trails yet,
				so this switch is reserved for content ported in later batches.
				Default: Off.
				'''
		}

		StatInflation: {
			Label: Stat Inflation
			Tooltip:
				'''
				Raises this mod's ported weapons to the inflated tier named by the author.
				Neutron Blade: damage goes from 855 to 4275 while enabled (the right-click explosion is spawned at x10 of the panel, so it scales along).
				Neutron Pulse: damage goes from 580 to 2900 while enabled (the bullets and the right-click explosion are both derived from the panel, so they scale along).
				Independent from the other switches; toggling takes effect immediately in-game, no reload needed.
				Default: Off.
				'''
		}
	}
}
